C_NORMAL = 0 
C_NEAR = 1 
C_HIGHSPEED = 2 
C_SHIP = 3

-- mimimum zoom
CLU_Call("CameraRangeXY", C_NORMAL, 0, 38, 39.5)
CLU_Call("CameraRangeZ", C_NORMAL, 0, 10, 50)
CLU_Call("CameraRangeFOV", C_NORMAL, 0, 17, 20)
CLU_Call("CameraEnableRotate", C_NORMAL, 0, 1)
CLU_Call("CameraShowSize", C_NORMAL, 0, 65, 65)

CLU_Call("CameraRangeXY", C_NEAR, 0, 50, 35)
CLU_Call("CameraRangeZ", C_NEAR, 0, 10, 50)
CLU_Call("CameraRangeFOV", C_NEAR, 0, 12, 35)
CLU_Call("CameraEnableRotate", C_NEAR, 0, 1)
CLU_Call("CameraShowSize", C_NEAR, 0, 60, 60)

CLU_Call("CameraRangeXY", C_HIGHSPEED, 0, 50, 35)
CLU_Call("CameraRangeZ", C_HIGHSPEED, 0, 10, 50)
CLU_Call("CameraRangeFOV", C_HIGHSPEED, 0, 12, 35)
CLU_Call("CameraEnableRotate", C_HIGHSPEED, 0, 1)
CLU_Call("CameraShowSize", C_HIGHSPEED, 0, 60, 60) 

CLU_Call("CameraRangeXY", C_SHIP, 0, 50, 35)
CLU_Call("CameraRangeZ", C_SHIP, 0, 10, 50)
CLU_Call("CameraRangeFOV", C_SHIP, 0, 12, 35)
CLU_Call("CameraEnableRotate", C_SHIP, 0, 1)
CLU_Call("CameraShowSize", C_SHIP, 0, 65, 65)

-- maximum zoom
CLU_Call("CameraRangeXY", C_NORMAL, 1, 60, 30)
CLU_Call("CameraRangeZ", C_NORMAL, 1, 8 , 60)
CLU_Call("CameraRangeFOV", C_NORMAL, 1, 11, 38)
CLU_Call("CameraEnableRotate", C_NORMAL, 1, 1)
CLU_Call("CameraShowSize", C_NORMAL, 1, 94, 94)

CLU_Call("CameraRangeXY", C_NEAR, 1, 50, 35)
CLU_Call("CameraRangeZ", C_NEAR, 1, 10, 50)
CLU_Call("CameraRangeFOV", C_NEAR, 1, 12, 35)
CLU_Call("CameraEnableRotate", C_NEAR, 1, 1)
CLU_Call("CameraShowSize", C_NEAR, 1, 60, 60)

CLU_Call("CameraRangeXY", C_HIGHSPEED, 1, 50, 35)
CLU_Call("CameraRangeZ", C_HIGHSPEED, 1, 10, 50)
CLU_Call("CameraRangeFOV", C_HIGHSPEED, 1, 12, 35)
CLU_Call("CameraEnableRotate", C_HIGHSPEED, 1, 1)
CLU_Call("CameraShowSize", C_HIGHSPEED, 1, 60, 60) 

CLU_Call("CameraRangeXY", C_SHIP, 1, 50, 35)
CLU_Call("CameraRangeZ", C_SHIP, 1, 10, 50)
CLU_Call("CameraRangeFOV", C_SHIP, 1, 12, 35)
CLU_Call("CameraEnableRotate", C_SHIP, 1, 1)
CLU_Call("CameraShowSize", C_SHIP, 1, 65, 65)
