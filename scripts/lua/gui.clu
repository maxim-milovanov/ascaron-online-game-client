function setBackgroundMiddle(form, form_size_x, form_size_y, alpha, form_pos_x, form_pos_y)
	local tile_size = 7
	local image_x, image_y = 134, 21  -- координаты текстуры для центра

	-- === Углы ===
	local corners = {
		{ x=0, y=0, tex_x=110, tex_y=0 },                  -- верхний левый
		{ x=form_size_x-tile_size, y=0, tex_x=158, tex_y=0 },         -- верхний правый
		{ x=0, y=form_size_y-tile_size, tex_x=110, tex_y=48 },        -- нижний левый
		{ x=form_size_x-tile_size, y=form_size_y-tile_size, tex_x=158, tex_y=48 } -- нижний правый
	}
	for _, corner in ipairs(corners) do
		local img = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_pos_x + corner.x, form_pos_y + corner.y)
		UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, corner.tex_x, corner.tex_y)
		UI_SetAlpha(img, alpha)
	end

	-- === Верхняя и нижняя рамка ===
	if form_size_x > tile_size * 2 then
		local start_x = tile_size
		local usable_width = form_size_x - tile_size * 2
		local full_tiles = math.floor(usable_width / tile_size)
		local remainder = usable_width % tile_size

		for i = 0, full_tiles-1 do
			local pos_x = start_x + tile_size * i
			-- верх
			local img_top = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_pos_x + pos_x, form_pos_y)
			UI_LoadImage(img_top, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 134, 0)
			UI_SetAlpha(img_top, alpha)
			-- низ
			local img_bottom = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_pos_x + pos_x, form_pos_y + (form_size_y - tile_size))
			UI_LoadImage(img_bottom, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 134, 48)
			UI_SetAlpha(img_bottom, alpha)
		end
		if remainder > 0 then
			local pos_x = start_x + full_tiles * tile_size
			local img_top = UI_CreateCompent(form, IMAGE_TYPE, "image", remainder, tile_size, form_pos_x + pos_x, form_pos_y)
			UI_LoadImage(img_top, "./texture/ascaron_ui/asc-part-01.png", NORMAL, remainder, tile_size, 134, 0)
			UI_SetAlpha(img_top, alpha)
			local img_bottom = UI_CreateCompent(form, IMAGE_TYPE, "image", remainder, tile_size, form_pos_x + pos_x, form_pos_y + (form_size_y - tile_size))
			UI_LoadImage(img_bottom, "./texture/ascaron_ui/asc-part-01.png", NORMAL, remainder, tile_size, 134, 48)
			UI_SetAlpha(img_bottom, alpha)
		end
	end

	-- === Левая и правая рамка ===
	if form_size_y > tile_size * 2 then
		local start_y = tile_size
		local usable_height = form_size_y - tile_size * 2
		local full_tiles = math.floor(usable_height / tile_size)
		local remainder = usable_height % tile_size

		for i = 0, full_tiles-1 do
			local pos_y = start_y + tile_size * i
			-- левая
			local img_left = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_pos_x, form_pos_y + pos_y)
			UI_LoadImage(img_left, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 110, 21)
			UI_SetAlpha(img_left, alpha)
			-- правая
			local img_right = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_pos_x + (form_size_x - tile_size), form_pos_y + pos_y)
			UI_LoadImage(img_right, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 158, 21)
			UI_SetAlpha(img_right, alpha)
		end
		if remainder > 0 then
			local pos_y = start_y + full_tiles * tile_size
			local img_left = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, remainder, form_pos_x, form_pos_y + pos_y)
			UI_LoadImage(img_left, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, remainder, 110, 21)
			UI_SetAlpha(img_left, alpha)
			local img_right = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, remainder, form_pos_x + (form_size_x - tile_size), form_pos_y + pos_y)
			UI_LoadImage(img_right, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, remainder, 158, 21)
			UI_SetAlpha(img_right, alpha)
		end
	end

	-- === Центр формы ===
	if form_size_x > tile_size*2 and form_size_y > tile_size*2 then
		local start_x = tile_size
		local start_y = tile_size
		local usable_width = form_size_x - tile_size*2
		local usable_height = form_size_y - tile_size*2

		local full_tiles_x = math.floor(usable_width / tile_size)
		local remainder_x = usable_width % tile_size
		local full_tiles_y = math.floor(usable_height / tile_size)
		local remainder_y = usable_height % tile_size

		for y = 0, full_tiles_y-1 do
			for x = 0, full_tiles_x-1 do
				local pos_x = start_x + x*tile_size
				local pos_y = start_y + y*tile_size
				local img = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_pos_x + pos_x, form_pos_y + pos_y)
				UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, image_x, image_y)
				UI_SetAlpha(img, alpha)
			end
			if remainder_x > 0 then
				local pos_x = start_x + full_tiles_x*tile_size
				local pos_y = start_y + y*tile_size
				local img = UI_CreateCompent(form, IMAGE_TYPE, "image", remainder_x, tile_size, form_pos_x + pos_x, form_pos_y + pos_y)
				UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, remainder_x, tile_size, image_x, image_y)
				UI_SetAlpha(img, alpha)
			end
		end

		if remainder_y > 0 then
			for x = 0, full_tiles_x-1 do
				local pos_x = start_x + x*tile_size
				local pos_y = start_y + full_tiles_y*tile_size
				local img = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, remainder_y, form_pos_x + pos_x, form_pos_y + pos_y)
				UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, remainder_y, image_x, image_y)
				UI_SetAlpha(img, alpha)
			end
			if remainder_x > 0 then
				local pos_x = start_x + full_tiles_x*tile_size
				local pos_y = start_y + full_tiles_y*tile_size
				local img = UI_CreateCompent(form, IMAGE_TYPE, "image", remainder_x, remainder_y, form_pos_x + pos_x, form_pos_y + pos_y)
				UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, remainder_x, remainder_y, image_x, image_y)
				UI_SetAlpha(img, alpha)
			end
		end
	end
end

-- form_size_x - размер окна X
-- form_size_y - размер окна Y
-- form_pos_x - позиция создаваемого окна на холсте
-- form_pos_y - позиция создаваемого окна на холсте
-- @todo сделать чтобы эта функция создавала рамку размером form_size_x на form_size_y
function setBorderMiddle(form, form_size_x, form_size_y, alpha, form_pos_x, form_pos_y)
	local border = 2
	
	-- Верхняя полоса
	for pos = 0, (form_size_x - border), border do
		local img = UI_CreateCompent(form, IMAGE_TYPE, "image", border, border, form_pos_x + pos, form_pos_y)
		UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, border, border, 23, 15)
		UI_SetAlpha(img, alpha)
	end
	
	-- Нижняя полоса
	for pos = 0, (form_size_x - border), border do
		local img = UI_CreateCompent(form, IMAGE_TYPE, "image", border, border, form_pos_x + pos, form_pos_y + form_size_y)
		UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, border, border, 23, 15)
		UI_SetAlpha(img, alpha)
	end
	
	-- Левая полоса
	for pos = border, (form_size_x - border), border do
		local img = UI_CreateCompent(form, IMAGE_TYPE, "image", border, border, form_pos_x, form_pos_y + pos)
		UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, border, border, 23, 15)
		UI_SetAlpha(img, alpha)
	end
	
	-- Правая полоса
	for pos = border, (form_size_x - border), border do
		local img = UI_CreateCompent(form, IMAGE_TYPE, "image", border, border, form_pos_x + form_size_x - border, form_pos_y + pos)
		UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, border, border, 23, 15)
		UI_SetAlpha(img, alpha)
	end
end

function setScroll(form)
	scrollid = UI_GetScroll( form )
	UI_SetSize( scrollid, 2, 12)
	UI_LoadImage( scrollid, "./texture/ascaron_ui/asc-part-01.png", COMPENT_BACK, 3, 12, 13, 57)

	id = UI_GetScrollObj( scrollid, SCROLL_SCROLL )
	UI_LoadImage( id, "./texture/ascaron_ui/asc-part-01.png", COMPENT_BACK, 4, 45, 7, 56)
	UI_SetSize(id, 4, 45)
end

