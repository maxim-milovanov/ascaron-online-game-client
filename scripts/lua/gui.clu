function addEquip(x,y,name,form,skillid)
	_G["img"..name] = UI_CreateCompent( form, IMAGE_TYPE, "img"..name, 36,36, x-2 ,y -2 )
	UI_LoadImage( _G["img"..name], "texture/gui/eqform/"..name..".png", NORMAL, 36,36, 0, 0 )
	_G[name] = UI_CreateCompent( form, COMMAND_ONE_TYPE, name, 32, 32, x ,y )
	if skillid then
		UI_AddCompent( skillid, _G["img"..name] )
		UI_AddCompent( skillid, _G[name] )
	end
end

function addEquipGroup(X,Y,Xoff,Yoff,names,form,skillid)
	for i,v in pairs(names) do
		addEquip(X + (i-1)* Xoff ,Y + (i-1)* Yoff,v,form,skillid)
	end
end

------
-- Конвертация цвета html to argb
------
function argbColor(hex)
    -- Преобразуем HEX в компоненты R, G, B
    local r = tonumber(string.sub(hex, 1, 2), 16)
    local g = tonumber(string.sub(hex, 3, 4), 16)
    local b = tonumber(string.sub(hex, 5, 6), 16)
    
    local a = 255  -- полностью непрозрачный

    -- Считаем значение ARGB вручную через умножение
    return a * 16777216 + r * 65536 + g * 256 + b
    -- 16777216 = 2^24, 65536 = 2^16, 256 = 2^8
end

function setBackground(form, isbClose, form_size_x, form_size_y, alpha)
	local image_x, image_y = 54, 54
	local tile_size = 18
	
	-- Левый верхний угол
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, 0, 0)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 0, 0)
	UI_SetAlpha(image, alpha)
	
	-- Заливка между верхним левым и правым углом
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", form_size_x - (tile_size*2), tile_size, tile_size, 0)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, tile_size, 0)
	UI_SetAlpha(image, alpha)
	
	-- Правый верний угол
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_size_x - tile_size, 0)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, image_x - tile_size, 0)
	UI_SetAlpha(image, alpha)
	
	-- Заливка между левым верхним и нижним углом
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, form_size_y - (tile_size*2), 0, tile_size)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 0, tile_size)
	UI_SetAlpha(image, alpha)
	
	-- Заливка между правым верхним и нижним углом
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, form_size_y - (tile_size*2), form_size_x - tile_size, tile_size)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, tile_size*2, tile_size)
	UI_SetAlpha(image, alpha)
	
	-- Заливка центра
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", form_size_x - (tile_size*2), form_size_y - (tile_size*2), tile_size, tile_size)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, tile_size, tile_size)
	UI_SetAlpha(image, alpha)
	
	-- Нижний левый угол
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, 0, form_size_y - tile_size)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, 0, image_y - tile_size)
	UI_SetAlpha(image, alpha)
	
	-- Заливка между нижними левым и правым углом
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", form_size_x - (tile_size * 2), tile_size, tile_size, form_size_y - tile_size)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, tile_size, image_y - tile_size)
	UI_SetAlpha(image, alpha)
	
	-- Нижний правый угол
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", tile_size, tile_size, form_size_x - tile_size, form_size_y - tile_size)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, tile_size, tile_size, image_x - tile_size, image_y - tile_size)
	UI_SetAlpha(image, alpha)
	
	if (isbClose) then
		btnClose = UI_CreateCompent(form, BUTTON_TYPE, "btnClose", 14, 14, form_size_x - 34, 20)
		UI_LoadButtonImage(btnClose, "./texture/ascaron_ui/asc-part-01.png", 14, 14, 54, 0, TRUE)
		UI_SetButtonModalResult(btnClose, BUTTON_CLOSE)
	end
end

