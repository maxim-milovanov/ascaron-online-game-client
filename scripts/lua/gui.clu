function setBackgroundChaBar(form, size_x, size_y, alpha, form_size_x, form_size_y)
	-- Левый край
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", 11, 52, form_size_x, form_size_y)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 11, 52, 141, 57)
	UI_SetAlpha(image, alpha)
	
	-- Заполнение между левым и правым краем
	--image = UI_CreateCompent(form, IMAGE_TYPE, "image", 1, 52, form_size_x, form_size_y)
	--UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 1, 52, 152, 57) 
	
	if (size_x > 22) then
		for pos = 11, (size_x - 12), 1 do
			image = UI_CreateCompent(form, IMAGE_TYPE, "image", 1, 52, pos, form_size_y)
			UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 1, 52, 152, 57) 
			UI_SetAlpha(image, alpha)
		end
	end
	
	-- Правый край
	image = UI_CreateCompent(form, IMAGE_TYPE, "image", 11, 52, size_x - 11, form_size_y)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 11, 52, 153, 57)
	UI_SetAlpha(image, alpha)
end

-- Функция для построения сетки изображений (rows × cols)
-- form      - объект формы, на которую будут добавляться картинки
-- cols      - количество колонок (по ширине)
-- rows      - количество строк (по высоте)
-- indent    - отступ между ячейками (одинаковый по X и Y)
-- grdWidth  - ширина одной ячейки сетки (контейнера для изображения)
-- grdHeight - высота одной ячейки
-- imgPath   - путь к изображению, которое будет загружено
-- imgWidth  - ширина изображения
-- imgHeight - высота изображения
-- imgPosX   - смещение изображения по X внутри ячейки
-- imgPosY   - смещение изображения по Y внутри ячейки
-- startPosX - начальная координата X для сетки (левый верхний угол)
-- startPosY - начальная координата Y для сетки (левый верхний угол)
-- Функция для построения сетки изображений и возврата координат для innerSize (например, 32x32)
function CreateImageGrid(form, cols, rows, indent, grdWidth, grdHeight, imgPath, imgWidth, imgHeight, imgPosX, imgPosY, imgAlpha, startPosX, startPosY)
    local coords = {}

    for r = 1, rows do
        -- координата Y текущей строки
        local y = startPosY + (r - 1) * (grdHeight + indent)

        for c = 1, cols do
            -- координата X текущей колонки
            local x = startPosX + (c - 1) * (grdWidth + indent)

            -- уникальное имя контейнера
            local name = string.format("imgGrid_%d_%d", r, c)

            local imgGrid = UI_CreateCompent(form, IMAGE_TYPE, name, grdWidth, grdHeight, x, y)
            UI_LoadImage(imgGrid, imgPath, NORMAL, imgWidth, imgHeight, imgPosX, imgPosY)
			UI_SetAlpha(imgGrid, imgAlpha)
			
            -- координаты для вложенного innerSize×innerSize объекта (например 32х32), по центру
            local cx = x + (grdWidth  - 32) / 2
            local cy = y + (grdHeight - 32) / 2

            -- добавляем в список (строка заполняется слева направо)
            table.insert(coords, {x = cx, y = cy})
        end
    end

    return coords
end

-- Функция логирования сообщений
-- fileName - имя файла (например "grid_log.txt")
-- message  - строка для записи
function LogMsg(fileName, message)
	fileName = string.format("log/%s", fileName)
	
    local file, err = io.open(fileName, "a")
    if not file then
        print("Ошибка: не удалось открыть файл " .. fileName .. ": " .. err)
        return
    end

    -- добавляем дату и время к сообщению
    local timeStamp = os.date("%Y-%m-%d %H:%M:%S")
    file:write(string.format("[%s] %s\n", timeStamp, message))
    file:close()
end

-- Функция для добавления строки
function AddStatRow(index, caption, hint, labelName, btnName)
    local y = basestatgroup.y + (index * rowHeight)

    local image = UI_CreateCompent(frmState, IMAGE_TYPE, "image"..index, 219, 26, basestatgroup.x, y + 25)
    UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 219, 26, 440, 196)
    UI_AddCompent(skillid, image)

    local lab = UI_CreateCompent(frmState, LABELEX_TYPE, "lab_"..labelName, 30, 14, basestatgroup.x + 15, y + 30)
    UI_SetCaption(lab, caption)
    UI_SetTextColor(lab, argbColor("919191") )
    UI_SetLabelExFont(lab, EXO_Regular_S12, FALSE, COLOR_WHITE )
    UI_AddCompent(skillid, lab)

    local btn = UI_CreateCompent(frmState, BUTTON_TYPE, btnName, 20, 20, basestatgroup.x + 195, y + 28 )
    UI_LoadButtonImage(btn, "./texture/ascaron_ui/asc-part-01.png", 20, 20, 665, 199, TRUE )
    UI_SetHint(btn, hint)
    UI_AddCompent(skillid, btn)

    local valueLab = UI_CreateCompent(frmState, LABELEX_TYPE, "lab"..labelName, 30, 14, basestatgroup.x + 150, y + 30)
    UI_SetTextColor(valueLab, argbColor("d6d6d6") )
    UI_SetLabelExFont(valueLab, EXO_Regular_S12, FALSE, COLOR_WHITE )
    UI_AddCompent(skillid, valueLab)
end

function AddCharStat(index, caption, labelName)
    local y = statsGroup.y + (index * rowHeight)

    local lab = UI_CreateCompent(frmState, LABELEX_TYPE, "lab_"..labelName, 50, 14, statsGroup.x, y)
    UI_SetCaption(lab, caption)
    UI_SetTextColor(lab, argbColor("919191"))
    UI_SetLabelExFont(lab, EXO_Regular_S12, FALSE, COLOR_WHITE)
    UI_AddCompent(skillid, lab)

    local valueLab = UI_CreateCompent(frmState, LABELEX_TYPE, "lab"..labelName, 30, 14, statsGroup.x + 135, y)
    UI_SetTextColor(valueLab, argbColor("d6d6d6"))
    UI_SetLabelExFont(valueLab, EXO_Regular_S12, FALSE, COLOR_WHITE)
    UI_AddCompent(skillid, valueLab)
end

