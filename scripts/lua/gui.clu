-- 表单样式
-- 0 :普通; 1：全居中，2：x方向居中， 3 Y方向居中， 4：居左； 5：居右；6：居上；7 ：居下 ； 8 左上角，9 右上角，10 左下角 11 右下角
FORM_NONE=0			-- 普通
FORM_ALLCENTER=1		-- 全居中
FORM_XCENTER=2			-- x方向居中
FORM_YCENTER=3			-- Y方向居中
FORM_LEFT=4			-- 居左
FORM_RIGHT=5			-- 居右
FORM_TOP=6			-- 居上
FORM_BOTTOM=7			-- 居下
FORM_LEFTTOP=8			-- 左上角
FORM_RIGHTTOP=9			-- 右上角
