-- 14 - серая кнопка 130х42 (запрос на отряд\торговлю)
-- 15 - серая кнопка 54х42
-- 16 - красна кнопка 70х42
function CreateButton(type, frm, button_name, szCaption, szFont, size_x, size_y, posx, posy)
	local Item
	Item = UI_CreateCompent(frm, BUTTON_TYPE, button_name, size_x, size_y, posx, posy)
	
	if (type == 0) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-01.png", 420, 60, 0, 567, FALSE)
	elseif (type == 1) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("c2c2c1"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-01.png", 420, 60, 420, 567, FALSE)
	elseif (type == 2) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-01.png", 106, 42, 888, 1001, FALSE)
	-- Мини кнопка из гачи (use)
	elseif (type == 3) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-01.png", 70, 19, 940, 188, FALSE)
	elseif (type == 4) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-03.png", 165, 42, 0, 0, FALSE)
	elseif (type == 5) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("c2c2c1"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-03.png", 165, 42, 165, 0, FALSE)
	elseif (type == 6) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("c2c2c1"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-03.png", 130, 42, 0, 168, FALSE)
	elseif (type == 7) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-03.png", 130, 42, 130, 168, FALSE)
	elseif (type == 8) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("c2c2c1"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 74, 42, 607, 932, TRUE)
	elseif (type == 9) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 123, 41, 607, 978, FALSE)
	elseif (type == 10) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 138, 32, 732, 978, FALSE)
	elseif (type == 11) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("c2c2c1"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 138, 32, 872, 978, FALSE)
	elseif (type == 12) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 380, 42, 0, 1058, FALSE)
	elseif (type == 13) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("000000"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 130, 42, 475, 597, FALSE)
	elseif (type == 14) then
		UI_ButtonSetText(Item, szCaption, szFont, argbColor("c2c2c1"), 0, 0)
		UI_LoadButtonImage(Item, "./texture/ascaron_ui/asc-part-02.png", 130, 42, 475, 765, FALSE)
	elseif (type == 15) then
