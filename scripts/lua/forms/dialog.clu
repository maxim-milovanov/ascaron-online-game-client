-- Define Input Quantity Dialog
-----------------------------------------------------------------------
frmNumber = UI_CreateForm( "frmNumber",  FALSE, 480, 340, 397, 500, FALSE, FALSE )
UI_ShowForm( frmNumber, FALSE )
UI_AddFormToTemplete( frmNumber, FORM_DIALOG )
UI_SetFormStyle( frmNumber, 0 )
UI_SetIsDrag( frmNumber, TRUE )

-- background
setBackground(frmNumber, false, 480, 340, 255)

labInfo = UI_CreateCompent( frmNumber, LABELEX_TYPE, "labInfo", 59, 11, 35, 40 )
UI_SetCaption( labInfo, "Please Input Quantity" )
UI_SetTextColor( labInfo, argbColor("bcbbbb") )
UI_SetLabelExFont( labInfo, EXO_Regular_S17, FALSE, COLOR_968774 )

image = UI_CreateCompent(frmNumber, IMAGE_TYPE,"image", 420, 55, 30, 95)
UI_LoadImage( image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 420, 60, 420, 747)

edtNumber = UI_CreateCompent( frmNumber, EDIT_TYPE, "edtNumber", 420, 20, 50, 110 )
