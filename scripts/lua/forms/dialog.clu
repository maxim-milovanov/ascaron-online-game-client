UI_SetEditMaxNum( edtNumber, 32 )
UI_SetEditMaxNumVisible( edtNumber, 32 )
UI_SetEditCursorColor( edtNumber, argbColor("c0c0c0") )
UI_SetEditFont( edtNumber, EXO_Regular_S20 )
