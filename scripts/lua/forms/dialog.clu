-----------------------------------------------------------------------
-- Define Quantity Price Dialog
-----------------------------------------------------------------------	
frmTrade = UI_CreateForm( "frmTrade",  FALSE, 330, 145, 397, 450, FALSE, FALSE )
UI_ShowForm( frmTrade, FALSE )
UI_AddFormToTemplete( frmTrade, FORM_DIALOG )
UI_SetIsDrag( frmTrade, TRUE )
UI_SetFormStyle( frmTrade, 2 )
UI_SetFormStyleEx(frmTrade, FORM_CENTERBOTTOM, 0, 300)

setBackground(frmTrade, false, 330, 145, 255)

image = UI_CreateCompent(frmTrade, IMAGE_TYPE,"image", 90, 32, 70, 50)
UI_LoadImage( image, "./texture/ascaron_ui/asc-part-02.png", NORMAL, 90, 32, 917, 937)

image = UI_CreateCompent(frmTrade, IMAGE_TYPE,"image", 38, 38, 23, 47)
UI_LoadImage( image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 55, 55, 52, 49)

cmdItem = UI_CreateCompent(frmTrade, COMMAND_ONE_TYPE, "cmdItem", 32, 32, 26, 50)

labName = UI_CreateCompent(frmTrade, LABELEX_TYPE, "labName", 330, 14, 0, 20)
UI_SetCaption( labName, "INVENTORY" )
UI_SetTextColor( labName, COLOR_WHITE )
UI_SetLabelExFont( labName, EXO_Regular_S14, FALSE, COLOR_BLACK )
UI_SetCaptionIsCenter(labName, TRUE)

labSum = UI_CreateCompent( frmTrade, LABELEX_TYPE, "labSum", 23, 11, 172, 52 + 5 )
UI_SetCaption( labSum, "Cost:" )
UI_SetTextColor( labSum, argbColor("c0c0c0"))
UI_SetLabelExFont( labSum, EXO_Regular_S14, FALSE, COLOR_WHITE )

edtNumber = UI_CreateCompent(frmTrade, EDIT_TYPE, "edtNumber", 50, 20, 80, 52 + 5)
UI_SetTextColor( edtNumber, argbColor("c0c0c0") )
UI_SetEditMaxNum( edtNumber, 3 )
UI_SetEditMaxNumVisible( edtNumber, 3 )
UI_SetEditCursorColor( edtNumber, argbColor("c0c0c0") )
UI_SetEditFont( edtNumber, EXO_Regular_S14 )
UI_SetEditClue(edtNumber, "Quantity", argbColor("908a92"))

labPrice = UI_CreateCompent( frmTrade, LABELEX_TYPE, "labPrice", 87, 11, 212, 52 + 5)
UI_SetCaption( labPrice, "0" )
UI_SetTextColor( labPrice, argbColor("ffffff"))
UI_SetLabelExFont( labPrice, EXO_Regular_S14, FALSE, COLOR_WHITE )

btnYes = CreateButton(10, frmTrade, "btnYes", "ACCEPT", EXO_Regular_S16, 138, 32, 172, 93+ 5)
UI_SetButtonModalResult( btnYes, BUTTON_YES )
UI_SetEditEnterButton( edtNumber, btnYes )

btnNo = CreateButton(11, frmTrade, "btnNo", "CANCEL", EXO_Regular_S16, 138, 32, 23, 93+ 5)
UI_SetButtonModalResult( btnNo, BUTTON_CLOSE )

