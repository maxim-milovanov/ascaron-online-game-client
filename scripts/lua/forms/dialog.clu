-- botton "ok"
btnYes = CreateButton(0, frmNumber, "btnYes", "ACCEPT", EXO_Regular_S20, 420, 60, 30, 180)
UI_SetButtonModalResult( btnYes, BUTTON_YES )
UI_SetEditEnterButton( edtNumber, btnYes )

--botton "cancel"
btnNo = CreateButton(1, frmNumber, "btnNo", "CANCEL", EXO_Regular_S20, 420, 60, 30, 250)
UI_SetButtonModalResult( btnNo, BUTTON_CLOSE )

