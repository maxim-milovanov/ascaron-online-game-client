n=0
while 1 do
	name = "texture/gui/face/"..(n+1)..".tga"   	
    	UI_AddFaceToGrid( grdFace, name, 16, 16, 0, 0, 1, 0 )
	UI_SetTextParse( n , name, 16, 16 , 0 , 0 ,1 )
	n = n + 1    	
    	if n>=77 then break end
end

