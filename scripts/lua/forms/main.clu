-- Fast bar
-----------------------------------------------------------------------------------
frmFast = UI_CreateForm("frmFast", FALSE, 601, 82, 360, 0, TRUE, FALSE)
UI_ShowForm(frmFast, TRUE)
UI_AddFormToTemplete( frmFast, FORM_MAIN)
UI_SetIsDrag(frmFast, true)
UI_FormSetIsEscClose(frmFast, FALSE)
UI_SetFormStyleEx(frmFast, FORM_CENTERBOTTOM, 0, 60)

imgfscMainNA = {}
imgfscMainNB = {}

local grd = CreateImageGrid(frmFast, 12, 2, 5, 38, 38, "./texture/ascaron_ui/asc-part-01.png", 55, 55, 110, 0, 170, 43, 0)
for i, pos in ipairs(grd) do
    local slot = i-1
    local compName

    if (slot < 12) then
		compName = string.format("fscMainF%d", slot)  -- первые 12 F
		
		image = UI_CreateCompent( frmFast, IMAGE_TYPE, "image", 32, 32, pos.x, pos.y)
		UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 32, 32, 12 + (i-1) * 55, 411, FALSE)
    else
        compName = string.format("fscMainN%d", slot)  -- следующие N
		
		local a = i - 12
		imgfscMainNA[a] = UI_CreateCompent( frmFast, IMAGE_TYPE, "imgfscMainNA" .. a, 32, 32, pos.x, pos.y)
		UI_LoadImage(imgfscMainNA[a], "./texture/ascaron_ui/asc-part-01.png", NORMAL, 32, 32, 12 + (a-1) * 55, 466, FALSE)
		
		imgfscMainNB[a] = UI_CreateCompent( frmFast, IMAGE_TYPE, "imgfscMainNB" .. a, 32, 32, pos.x, pos.y)
		UI_LoadImage(imgfscMainNB[a], "./texture/ascaron_ui/asc-part-01.png", NORMAL, 32, 32, 12 + (a-1) * 55, 521, FALSE)
		
    end
	
    -- создаём компонент
    local comp = UI_CreateCompent(frmFast, FAST_COMMANG_TYPE, compName, 32, 32, pos.x, pos.y)
	
end

