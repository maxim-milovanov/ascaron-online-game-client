setBackground(frmEditMaxim, false, 400, 154, 225)

imgage = UI_CreateCompent(frmEditMaxim, IMAGE_TYPE, "imgage", 283, 42, 87, 30)
UI_LoadImage(imgage, "./texture/ascaron_ui/asc-part-03.png", NORMAL, 283, 42, 330, 42)

