	lstNum = UI_CreateListView( frmManage, "lstNum", 458, 370, 36, 180, 5, eNoTitle)
	UI_ListViewSetTitle( lstNum, 0, 26, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 1, 150, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 2, 60, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 3, 55, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 4, 28, "", 0, 0, 0, 0 )
