	lstNum = UI_CreateListView( frmManage, "lstNum", 464, 323 - 27, 32, 180, 5, eNoTitle)
	UI_ListViewSetTitle( lstNum, 0, 26, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 1, 158, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 2, 55, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 3, 55, "", 0, 0, 0, 0 )
	UI_ListViewSetTitle( lstNum, 4, 28, "", 0, 0, 0, 0 )
	UI_ListSetItemMargin(lstNum, 8, 5 )						-- Перемещение текста внутри строки
	--UI_SetListRowHeight(lstNum, 46 )							-- Отступ строк между собой
	UI_ListLoadSelectImage(lstNum, "./texture/ascaron_ui/asc-part-03.png", 468, 30, 330, 84)
	UI_SetListIsMouseFollow(lstNum, FALSE)
	UI_SetListRowHeight( lstNum, 26 )
	setScroll(lstNum)
	UI_AddCompent(pgPlayers, lstNum)

