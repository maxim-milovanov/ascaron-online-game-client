frmManage = UI_CreateForm( "frmManage", FALSE, 528, 600 - 10, 0, 0, TRUE, FALSE )
UI_FormSetHotKey( frmManage, ALT_KEY, HOTKEY_C )
UI_ShowForm( frmManage, FALSE )
UI_AddFormToTemplete( frmManage, 1 )
UI_SetIsDrag( frmManage, FALSE )
UI_SetFormStyleEx(frmManage, FORM_CENTERBOTTOM, 0, 160)

PlayersMouseRight = UI_CreateCompent( frmManage, MENU_TYPE, "PlayersMouseRight", 130, 97, 240, 468 )
UI_MenuLoadImage( PlayersMouseRight, TRUE, FALSE, "./texture/ascaron_ui/asc-part-01.png", 1, 1, 18, 18, "./texture/ascaron_ui/asc-part-01.png", 1, 1)
UI_SetMargin( PlayersMouseRight, 10, 5, 5, 5 )
UI_MenuLoadFont(PlayersMouseRight, EXO_Regular_S14, argbColor("FFD166"), argbColor("ffffff"), argbColor("737374"))

ApplyMouseRight = UI_CreateCompent( frmManage, MENU_TYPE, "ApplyMouseRight", 130, 97, 240, 468 )
UI_MenuLoadImage( ApplyMouseRight, TRUE, FALSE, "./texture/ascaron_ui/asc-part-01.png", 1, 1, 18, 18, "./texture/ascaron_ui/asc-part-01.png", 1, 1)
UI_SetMargin( ApplyMouseRight, 10, 5, 5, 5 )
UI_MenuLoadFont(ApplyMouseRight, EXO_Regular_S14, argbColor("FFD166"), argbColor("ffffff"), argbColor("737374"))

setBackground(frmManage, true, 528, 600 - 10, 225)
