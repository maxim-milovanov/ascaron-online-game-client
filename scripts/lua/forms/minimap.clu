-----------------------------------------------------------------------
-- Minimap
-----------------------------------------------------------------------	
frmMinimap = UI_CreateForm( "frmMinimap", FALSE, 200, 210, 20, 20, TRUE, FALSE )
UI_ShowForm( frmMinimap, TRUE )
UI_AddFormToTemplete( frmMinimap, FORM_MAIN )
UI_FormSetIsEscClose( frmMinimap, FALSE )
UI_SetFormStyleEx(frmMinimap, FORM_RIGHTTOP, 20, 20)

setBackgroundMiddle(frmMinimap, 200, 30, 200, 0, 0)

labMapName = UI_CreateCompent( frmMinimap, LABELEX_TYPE, "labMapName", 51, 12, 10, 8 )
UI_SetCaption( labMapName, "0" )
UI_SetTextColor( labMapName, COLOR_WHITE )
UI_SetLabelExFont( labMapName, EXO_Regular_S12, FALSE, COLOR_BLACK )

labServerTime = UI_CreateCompent( frmMinimap, LABELEX_TYPE, "labServerTime", 51, 12, 136, 8)
UI_SetCaption(labServerTime, "00:00:00")
UI_SetTextColor(labServerTime, argbColor("babbbb"))
UI_SetLabelExFont(labServerTime, EXO_Regular_S12, FALSE, COLOR_BLACK)

setBorderMiddle(frmMinimap, 200, 200, 200, 0, 35)

imgMinimapRect = UI_CreateCompent( frmMinimap, IMAGE_TYPE, "imgMinimapRect", 198, 198, 2, 37 )

n  = 0
while 1 do
	local name = "labMapPos"..n
	labMapPos = UI_CreateCompent( frmMinimap, LABELEX_TYPE, name, 200, 16, 0, 40)
	UI_SetCaption( labMapPos, "2200, 2200" )
	UI_SetTextColor( labMapPos, COLOR_WHITE )
	UI_SetLabelExFont( labMapPos, EXO_Regular_S12, TRUE, COLOR_BLACK )
	
	if n ~= 0 then 
		UI_SetIsShow( labMapPos, FALSE ) 
	end
	
	n = n + 1
	if n == 10 then 
		break 
	end	
end

btnSearch = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnSearch", 30, 30, -15, 100)
UI_LoadButtonImage( btnSearch, "./texture/ascaron_ui/asc-part-01.png", 30, 30, 138, 113, TRUE)
UI_SetHint(btnSearch, "Radar (Alt + R)")
UI_SetAlpha(btnSearch, 220)

btnOpen = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnOpen", 30, 30, -15, 135)
UI_LoadButtonImage( btnOpen, "./texture/ascaron_ui/asc-part-01.png", 30, 30, 138, 143, TRUE)
UI_SetHint(btnOpen, "World Map (Alt + W)")
UI_SetAlpha(btnOpen, 220)

btnTeleports = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnTeleports", 30, 30, -15, 170)
UI_LoadButtonImage( btnTeleports, "./texture/ascaron_ui/asc-part-01.png", 30, 30, 138, 173, TRUE)
UI_SetHint(btnTeleports, "Area Manager (Alt + V)")
UI_SetAlpha(btnTeleports, 220)

btnSetTrade = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnSetTrade", 40, 40, 31, 247)
UI_LoadButtonImage( btnSetTrade, "./texture/ascaron_ui/asc-part-01.png", 40, 40, 260, 153, TRUE)

btnOpenStore = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnOpenStore", 40, 40, 31 + 49 + 49, 247)
UI_LoadButtonImage( btnOpenStore, "./texture/ascaron_ui/asc-part-01.png", 40, 40, 260, 113, TRUE)
UI_SetHint(btnOpenStore, "Accessing Item Mall")
UI_SetAlpha(btnOpenStore, 200)

-----------------------------------------------------------------------
-- Select map
-----------------------------------------------------------------------	
frmSearch = UI_CreateForm( "frmSearch", FALSE, 231, 109, 300, 200, TRUE, FALSE )
UI_ShowForm( frmSearch, FALSE )
UI_AddFormToTemplete( frmSearch, FORM_MAIN )
UI_FormSetIsEscClose( frmSearch, FALSE )
UI_FormSetHotKey( frmSearch, ALT_KEY, HOTKEY_T )
UI_SetIsDrag( frmSearch, FALSE )

imgSearch = UI_CreateCompent( frmSearch, IMAGE_TYPE, "imgSearch", 231, 109, 0, 0 )
UI_LoadImage( imgSearch, "texture/gui/select-map.png", NORMAL, 231, 109, 8, 1 )

edtLeft = UI_CreateCompent( frmSearch, EDIT_TYPE, "edtLeft", 45, 11, 107, 54 )
UI_SetTextColor( edtLeft, COLOR_FFEDCF )
UI_SetLabelExFont( edtLeft, EXO_Regular_S12, FALSE, COLOR_WHITE )
UI_SetEditMaxNum( edtLeft, 4 )
UI_SetEditMaxNumVisible( edtLeft, 4 )
UI_SetEditCursorColor( edtLeft, COLOR_WHITE )

edtRight = UI_CreateCompent( frmSearch, EDIT_TYPE, "edtRight", 28, 11, 180, 54 )
UI_SetTextColor( edtRight, COLOR_FFEDCF )
UI_SetLabelExFont( edtRight, EXO_Regular_S12, FALSE, COLOR_WHITE )
UI_SetEditMaxNum( edtRight, 4 )
UI_SetEditMaxNumVisible( edtRight, 4 )
UI_SetEditCursorColor( edtRight, COLOR_WHITE )

btnYes = UI_CreateCompent( frmSearch, BUTTON_TYPE, "btnYes", 93, 32, 23, 92 )
UI_LoadButtonImage( btnYes, "texture/gui/friends.png", 93, 32, 0, 494, FALSE )
UI_SetEditEnterButton( edtTradeGold, btnYes )

btnNo = UI_CreateCompent( frmSearch, BUTTON_TYPE, "btnNo", 93, 32, 119, 92 )
UI_LoadButtonImage( btnNo, "texture/gui/friends.png", 93, 32, 93, 494, FALSE )
UI_SetButtonModalResult( btnNo, BUTTON_CLOSE )

cboMap  = UI_CreateCompent( frmSearch, COMBO_TYPE, "cboMap", 98, 20, 100, 20-4 )
UI_ComboSetStyle( cboMap, TRUE )
UI_ComboSetTextColor( cboMap, COLOR_WHITE )
lstMap = UI_GetList( cboMap )
UI_SetListFontColor( lstMap, COLOR_WHITE, COLOR_WHITE )
UI_SetSize( lstMap, 81, 64 )
UI_SetMargin( lstMap, 16,6,16,0 )
UI_SetListRowHeight( lstMap, 18 )
UI_LoadImage( lstMap, "texture/gui/select-map.png", COMPENT_BACK, 81, 68, 4, 114 )
UI_AddListText( lstMap, "Ascaron" )
UI_AddListText( lstMap, "Magical Ocean" )
UI_AddListText( lstMap, "Deep Blue" )
UI_SetListIsMouseFollow( lstMap, TRUE)
UI_ComboSetTextColor( lstMap, COLOR_WHITE )
