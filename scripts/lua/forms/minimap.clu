btnYes = CreateButton(4, frmSearch, "btnYes", "ACCEPT", EXO_Regular_S16, 165, 42, 205, 82)

btnNo = CreateButton(5, frmSearch, "btnNo", "CANCEL", EXO_Regular_S16, 165, 42, 30, 82)
UI_SetButtonModalResult( btnNo, BUTTON_CLOSE )
