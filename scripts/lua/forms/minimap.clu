-----------------------------------------------------------------------
-- Minimap
-----------------------------------------------------------------------	
frmMinimap = UI_CreateForm( "frmMinimap", FALSE, 200, 210, 20, 20, TRUE, FALSE )
UI_ShowForm( frmMinimap, TRUE )
UI_AddFormToTemplete( frmMinimap, FORM_MAIN )
UI_FormSetIsEscClose( frmMinimap, FALSE )
UI_SetFormStyleEx(frmMinimap, FORM_RIGHTTOP, 20, 20)

image = UI_CreateCompent(frmMinimap, IMAGE_TYPE, "image", 200, 30, 0, 0)
UI_LoadImage(image, "./texture/ascaron_ui/frmMinimap.png", NORMAL, 200, 30, 0, 0)
UI_SetAlpha(frmMinimap, 225)

labMapName = UI_CreateCompent( frmMinimap, LABELEX_TYPE, "labMapName", 51, 12, 10, 8 )
UI_SetCaption( labMapName, "0" )
UI_SetTextColor( labMapName, COLOR_WHITE )
UI_SetLabelExFont( labMapName, EXO_Regular_S12, FALSE, COLOR_BLACK )

labServerTime = UI_CreateCompent( frmMinimap, LABELEX_TYPE, "labServerTime", 51, 12, 136, 8)
UI_SetCaption(labServerTime, "00:00:00")
UI_SetTextColor(labServerTime, argbColor("babbbb"))
UI_SetLabelExFont(labServerTime, EXO_Regular_S12, FALSE, COLOR_BLACK)

setBorderMiddle(frmMinimap, 200, 200, 200, 0, 35)

imgMinimapRect = UI_CreateCompent( frmMinimap, IMAGE_TYPE, "imgMinimapRect", 198, 198, 2, 37 )

n  = 0
while 1 do
	local name = "labMapPos"..n
	labMapPos = UI_CreateCompent( frmMinimap, LABELEX_TYPE, name, 200, 16, 0, 40)
	UI_SetCaption( labMapPos, "2200, 2200" )
	UI_SetTextColor( labMapPos, COLOR_WHITE )
	UI_SetLabelExFont( labMapPos, EXO_Regular_S14, TRUE, COLOR_BLACK )
	
	if n ~= 0 then 
		UI_SetIsShow( labMapPos, FALSE ) 
	end
	
	n = n + 1
	if n == 10 then 
		break 
	end	
end

btnSearch = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnSearch", 30, 30, -15, 100 - 49)
UI_LoadButtonImage( btnSearch, "./texture/ascaron_ui/asc-part-01.png", 30, 30, 138, 113, TRUE)
UI_SetHint(btnSearch, "Radar (Alt + T)")
UI_SetAlpha(btnSearch, 220)

btnOpenWorldMap = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnOpenWorldMap", 30, 30, -15, 135 - 49)
UI_LoadButtonImage(btnOpenWorldMap, "./texture/ascaron_ui/asc-part-01.png", 30, 30, 138, 143, TRUE)
UI_SetHint(btnOpenWorldMap, "World Map (Alt + W)")
UI_SetAlpha(btnOpenWorldMap, 220)

btnTeleports = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnTeleports", 30, 30, -15, 170 - 49)
UI_LoadButtonImage( btnTeleports, "./texture/ascaron_ui/asc-part-01.png", 30, 30, 138, 173, TRUE)
UI_SetHint(btnTeleports, "Area Manager (Alt + V)")
UI_SetAlpha(btnTeleports, 220)

btnWiki = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnWiki", 30, 30, -15, 205 - 49)
UI_LoadButtonImage(btnWiki, "./texture/ascaron_ui/asc-part-05.png", 30, 30, 340, 0, TRUE)
UI_SetHint(btnWiki, "Wikipedia")
UI_SetAlpha(btnWiki, 220)

btnDatabase = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnDatabase", 30, 30, -15, 240 - 49)
UI_LoadButtonImage(btnDatabase, "./texture/ascaron_ui/asc-part-05.png", 30, 30, 340, 30, TRUE)
UI_SetHint(btnDatabase, "Database (ALT + I)")
UI_SetAlpha(btnDatabase, 220)

btnOpenMarket = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnOpenMarket", 44, 44, 14, 247)
UI_LoadButtonImage(btnOpenMarket, "./texture/ascaron_ui/asc-part-05.png", 44, 44, 460, 0, TRUE)
--UI_SetHint(btnOpenMarket, "Store (Alt + F)")
UI_SetAlpha(btnOpenMarket, 220)

btnOpenStore = UI_CreateCompent( frmMinimap, BUTTON_TYPE, "btnOpenStore", 117, 44, 54 + 15, 247)
UI_LoadButtonImage( btnOpenStore, "./texture/ascaron_ui/asc-part-03.png", 117, 44, 688, 182, FALSE)
UI_SetHint(btnOpenStore, "Store (Alt + F)")
UI_SetAlpha(btnOpenStore, 220)

