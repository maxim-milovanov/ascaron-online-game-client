edtRight = UI_CreateCompent( frmSearch, EDIT_TYPE, "edtRight", 98, 42, 286 + 17, 20 + 12)
UI_SetTextColor( edtRight, argbColor("c0c0c0") )
UI_SetEditMaxNum( edtRight, 4 )
UI_SetEditMaxNumVisible( edtRight, 4 )
UI_SetEditCursorColor( edtRight, argbColor("c0c0c0") )
UI_SetEditFont( edtRight, EXO_Regular_S16 )
