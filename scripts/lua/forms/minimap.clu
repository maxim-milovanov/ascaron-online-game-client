-- Radar (input x, y)
-----------------------------------------------------------------------	
frmSearch = UI_CreateForm( "frmSearch", FALSE, 400, 144, 0, 0, TRUE, FALSE )
UI_ShowForm(frmSearch, FALSE)
UI_AddFormToTemplete(frmSearch, FORM_MAIN)
UI_FormSetIsEscClose(frmSearch, TRUE )
UI_FormSetHotKey(frmSearch, ALT_KEY, HOTKEY_T)
UI_SetIsDrag(frmSearch, TRUE)
UI_SetFormStyleEx(frmSearch, FORM_CENTERBOTTOM, 0, 160)

setBackground(frmSearch, false, 400, 144, 225)

labCoordinates = UI_CreateCompent(frmSearch, LABELEX_TYPE, "labCoordinates", 420, 20, 55, 32)
UI_SetCaption(labCoordinates, "Coordinates")
UI_SetTextColor(labCoordinates, argbColor("c0c0c0"))
UI_SetLabelExFont(labCoordinates, EXO_Regular_S16, FALSE, COLOR_BLACK)

