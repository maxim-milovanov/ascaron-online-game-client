UI_LoadImage(imgage, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 88, 42, 885, 513)

edtLeft = UI_CreateCompent( frmSearch, EDIT_TYPE, "edtLeft", 98, 42, 184 + 25 - 8, 20 + 12)
UI_SetTextColor( edtLeft, argbColor("c0c0c0") )
