frmTickets = UI_CreateForm( "frmTickets", FALSE, 429, 562, 0, 0, TRUE, FALSE )
UI_ShowForm( frmTickets, TRUE )
UI_SetIsDrag( frmTickets, TRUE )
UI_AddFormToTemplete( frmTickets, FORM_MAIN )
UI_FormSetIsEscClose( frmTickets, TRUE )
UI_FormSetHotKey( frmTickets, ALT_KEY, HOTKEY_V)
UI_SetFormStyleEx(frmTickets, FORM_CENTERBOTTOM, 0, 160)

setBackground(frmTickets, true, 429, 562, 225)

labFormname = UI_CreateCompent(frmTickets, LABELEX_TYPE, "labFormname", 429, 14, 0, 20)
UI_SetCaption( labFormname, "AREA MANAGER" )
UI_SetTextColor( labFormname, COLOR_WHITE )
UI_SetLabelExFont( labFormname, EXO_Regular_S14, FALSE, COLOR_BLACK )
UI_SetCaptionIsCenter(labFormname, TRUE)

btnMazes = UI_CreateCompent(frmTickets, BUTTON_TYPE, "btnMazes", 123, 31, 30, 48)
UI_LoadButtonImage(btnMazes, "./texture/ascaron_ui/asc-part-02.png", 123, 31, 608, 464, FALSE)

btnAreas = UI_CreateCompent(frmTickets, BUTTON_TYPE, "btnAreas", 123, 31, 153, 48)
UI_LoadButtonImage(btnAreas, "./texture/ascaron_ui/asc-part-02.png", 123, 31, 731, 464, FALSE)

btnBosses = UI_CreateCompent(frmTickets, BUTTON_TYPE, "btnBosses", 123, 31, 276, 48)
UI_LoadButtonImage(btnBosses, "./texture/ascaron_ui/asc-part-02.png", 123, 31, 854, 464, FALSE)

-- btnNpc = UI_CreateCompent( frmTickets, BUTTON_TYPE, "btnNpc", 91, 47, 45+ 293, 65 )
-- UI_LoadButtonImage( btnNpc, "./texture/gui/btnServer.png", 91, 47, 1132, 519, FALSE )

image = UI_CreateCompent(frmTickets, IMAGE_TYPE, "image", 369, 2, 30, 50+29)
UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 369, 2, 0, 381)

local szTicketName = {}
local szTicketPrice = {}
local szTicketImgPrice = {}
local szTicketDesc = {}
local szTicketIcon = {}
local szBtnLine = {}

local posx = 30
local posy = 33
local padding = 72

for page_id = 0, 3, 1 do
	local str_id = 1
	
	for i = 0, 71, 1 do
		szTicketName[page_id] = {}
		szTicketPrice[page_id] = {}
		szTicketImgPrice[page_id] = {}
		szTicketDesc[page_id] = {}
		szTicketIcon[page_id] = {}
		szBtnLine[page_id] = {}

		-- icon
		local _posy = posy + (str_id * padding)
		szTicketIcon[page_id][i] =  UI_CreateCompent( frmTickets, IMAGE_TYPE, "imgIcon_".. page_id.."_" .. i, 32, 32, posx + 15, _posy + 6)
		
		szBtnLine[page_id][i] = UI_CreateCompent( frmTickets, BUTTON_TYPE, "btnLine_"..page_id.."_"..i, 369, 62, posx, _posy - 9 )
		UI_LoadButtonImage(szBtnLine[page_id][i], "./texture/ascaron_ui/asc-part-02.png", 369, 62, 608, 597, FALSE)
		
		szTicketName[page_id][i] = UI_CreateCompent( frmTickets, LABELEX_TYPE, "labName_"..page_id.."_"..i, 10, 150, posx + 64,  _posy + 6 )
		UI_SetCaption( szTicketName[page_id][i], "Item "..i)
		UI_SetTextColor( szTicketName[page_id][i], argbColor("ffffff") )
		UI_SetLabelExFont( szTicketName[page_id][i], EXO_Regular_S14, FALSE, COLOR_WHITE )
		UI_SetIsShow(szTicketName[page_id][i],FALSE)
		
		szTicketPrice[page_id][i] = UI_CreateCompent( frmTickets, LABELEX_TYPE, "labPrice_"..page_id.."_"..i, 10, 150, posx + 32 + 229 + 15, _posy + 18)
		UI_SetCaption( szTicketPrice[page_id][i], "1.000 ")
		UI_SetTextColor( szTicketPrice[page_id][i], argbColor("e9e9e9") )
		UI_SetLabelExFont( szTicketPrice[page_id][i], EXO_Regular_S12, FALSE, COLOR_WHITE )
		UI_SetIsShow(szTicketPrice[page_id][i],FALSE)
		
		szTicketImgPrice[page_id][i] =  UI_CreateCompent( frmTickets, IMAGE_TYPE, "imgPrice_".. page_id.."_" .. i, 29, 29, 330 + posx, _posy + 10)
		UI_LoadImage( szTicketImgPrice[page_id][i], "./texture/ascaron_ui/asc-part-01.png", NORMAL, 29, 29, 243, 326)
		
		_posy = _posy + 25
		szTicketDesc[page_id][i] = UI_CreateCompent( frmTickets, LABELEX_TYPE, "labDescription_"..page_id.."_"..i, 10, 150, posx + 64, _posy )
		UI_SetCaption( szTicketDesc[page_id][i], "Remark"..i)
		UI_SetTextColor( szTicketDesc[page_id][i], argbColor("e9e9e9"))
		UI_SetLabelExFont( szTicketDesc[page_id][i], EXO_Regular_S12, FALSE, COLOR_WHITE )
		
		str_id = str_id + 1
	
		if (str_id > 6) then
			str_id = 1
		end
	end
	
end

