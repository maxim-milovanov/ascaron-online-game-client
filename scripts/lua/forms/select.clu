UI_LoadButtonImage( btnDel, "./texture/ascaron_ui/asc-part-01.png", 60, 60, 0, 949, TRUE )

-- Play
btnYes = CreateButton(0, frmSelect, "btnYes", "PLAY", EXO_Regular_S20, 420, 60, 165, 15)

-- change pw
