-- background
imgSelect = UI_CreateCompent( frmSelect, IMAGE_TYPE, "imgSelect", 750, 90, 0, 0 )
UI_LoadImage( imgSelect, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 750, 90, 0, 1010)

-- Create
