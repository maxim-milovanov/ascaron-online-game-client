-- Main scene select cha
-----------------------------------------------------------------------
frmSelect = UI_CreateForm( "frmSelect", FALSE, 750, 90, 200, 0, TRUE, FALSE )
UI_ShowForm( frmSelect, TRUE )
UI_AddFormToTemplete( frmSelect, FORM_SELECT )
--UI_SetFormStyleEx( frmSelect, 7, 0, 2 )
