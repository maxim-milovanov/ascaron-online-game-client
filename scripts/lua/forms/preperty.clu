------
-- Слоты под эквип
------
local collum = {}
collum.left = { x = 0, y = 60, margin = 55 }
collum.right = { x = collum.left.x + 280, y = collum.left.y, margin = collum.left.margin }

-- универсальная функция для создания слота
local function createSlot(name, hint, col, row, offsetX, offsetY)
    offsetX = offsetX or 0
    offsetY = offsetY or 0

    local imgX = col.x + offsetX
    local imgY = col.y + (col.margin * row) + offsetY
    local cmdX = imgX + 3
    local cmdY = imgY + 3

    local img = UI_CreateCompent(frmState, IMAGE_TYPE, "cmdImg" .. name, 38, 38, imgX, imgY)
    UI_LoadImage(img, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 55, 55, 52, 49)

    local cmd = UI_CreateCompent(frmState, COMMAND_ONE_TYPE, "cmd" .. name, 32, 32, cmdX, cmdY)
    UI_SetHint(cmd, hint)

    UI_AddCompent(skillid, img)
    UI_AddCompent(skillid, cmd)

    return img, cmd
end

-- список слотов
local slots = {
    { "Head",       "Head",          collum.left, 0 },
    { "Body",       "Body",          collum.left, 1 },
    { "Glove",      "Glove",         collum.left, 2 },
    { "Shoes",      "Boots",         collum.left, 3 },
    { "LeftHand",   "Left hand",     collum.left, 4 },
    { "RightHand",  "Right hand",    collum.left, 5 },
    { "Cloak",      "Cloak",         collum.left, 6 },

    { "Necklace",   "Necklace",      collum.right, 0 },
    { "LRing",      "Left ring",     collum.right, 1 },
    { "RRing",      "Right ring",    collum.right, 2 },
    { "LBracelet",  "Left bracelet", collum.right, 3 },
    { "RBracelet",  "Right bracelet",collum.right, 4 },
    { "Belt",       "Belt",          collum.right, 5 },
    { "Handguard",  "Handguard",     collum.right, 6 },
}

-- создаём все обычные слоты
for _, s in ipairs(slots) do
    createSlot(s[1], s[2], s[3], s[4])
end

-- особые слоты с нестандартным смещением
createSlot("Pet", "Fairy", collum.left, 6, collum.left.margin * 1.63, collum.left.margin / 2.5)
createSlot("RearPet", "Hand pet", collum.left, 6, collum.left.margin * 2 * 1.27, collum.left.margin / 2.5)
createSlot("Mount", "Mount", collum.right, 6, -(collum.right.margin * 1.63), collum.right.margin / 2.5)


