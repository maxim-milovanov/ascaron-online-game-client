------
-- Party
------
for pos = 1, 4, 1 do
	local label = string.format("frmTeamMenber%d", pos)
	local labelname = string.format("labMenber%dName", pos)
	local labeldead = string.format("proTeamMenber%dDead", pos)
	local labelhp = string.format("proTeamMenber%dHP", pos)
	
	label = UI_CreateForm( label, FALSE, 176, 45, 20, 100 + (pos * 50), TRUE, FALSE)
	UI_ShowForm( label, FLASE )
	UI_SetIsDrag( label, FLASE )
	UI_AddFormToTemplete( label, FORM_MAIN )
	UI_FormSetIsEscClose( label, FALSE )
	
	image = UI_CreateCompent(label, IMAGE_TYPE, "image", 176, 45, 0, 0)
	UI_LoadImage(image, "./texture/ascaron_ui/frmTeamMenber.png", NORMAL, 176, 45, 0, 0)
	UI_SetAlpha(image, 225)
	
	image = UI_CreateCompent(label, IMAGE_TYPE, "image", 125, 15, 45, 22)
	UI_LoadImage(image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 125, 15, 534 + 50, 86)
	
	labelhp = UI_CreateCompent( label, PROGRESS_TYPE, labelhp, 125, 15, 45, 22)
	UI_LoadScaleImage( labelhp, "./texture/ascaron_ui/asc-part-01.png", PROGRESS_PROGRESS, 125, 15, 534 + 50, 102, 1.0, 1.0 )
	UI_SetHint(labelhp, "HP")
	UI_SetProgressHintStyle( labelhp, PROGRESS_HINT_NUM)
	
	d3dHead = UI_CreateCompent( label, UI3D_COMPENT_TYPE, "d3dHead", 36, 36, 3, 3 )
	d3dDown = UI_CreateCompent( label, UI3D_COMPENT_TYPE, "d3dDown", 176, 45, 0, 0 )
	
	image = UI_CreateCompent( label, IMAGE_TYPE, "image", 18, 18, 6, 25)
	UI_LoadImage( image, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 18, 18, 115, 61)

	labFLv = UI_CreateCompent( label, LABELEX_TYPE, "labFLv", 18, 10, 6, 28 )
	UI_SetTextColor( labFLv, argbColor("d0d0d1"))
	UI_SetLabelExFont( labFLv, EXO_Regular_S10, FALSE, COLOR_BLACK )
	UI_SetCaption( labFLv, "99" )
	UI_SetCaptionIsCenter(labFLv, TRUE)

	labelname = UI_CreateCompent( label, LABELEX_TYPE, labelname, 1, 1, 45, 5 )
	UI_SetCaption( labelname, "-" )
	UI_SetTextColor( labelname, argbColor("b9baba") )
	UI_SetLabelExFont( labelname, EXO_Regular_S12, FALSE, COLOR_BLACK )
	
	imgLeader = UI_CreateCompent( label, IMAGE_TYPE, "imgLeader", 15, 15, 155, 5 )
	UI_LoadImage( imgLeader, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 12, 12, 164, 239 )
	
	labeldead = UI_CreateCompent( label, IMAGE_TYPE, labeldead, 25, 25, 10, 5 )
	UI_LoadImage( labeldead, "./texture/ascaron_ui/asc-part-01.png", NORMAL, 25, 25, 138, 238 )
end

