x, y = 80, y + 50

for pos = 0, 2, 1 do
	if (pos > 0) then
		x = x + 40
	end
	
	local label = string.format("Item1_%d", pos)
	
	sltLabel = UI_CreateCompent(frmSetTrade, IMAGE_TYPE, "sltLabel", 36, 36, x, y)
	UI_LoadImage(sltLabel, "texture/gui/eqform/cmdArmet.png", NORMAL, 36, 36, 0, 0)
	
	label = UI_CreateCompent(frmSetTrade, COMMAND_ONE_TYPE, label, 32, 32, x + 2, y + 2)
end

