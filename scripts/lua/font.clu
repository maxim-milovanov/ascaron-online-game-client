------
-- Init font
------
function UI_CreateFont( font, size, thicknessBias, lineSpacing )		
	return CLU_Call("UI_CreateFont", font, size, thicknessBias, lineSpacing )
end

-- scale
local global_font_scale = 14.0 / 12.0

DEFAULT_FONT = UI_CreateFont( "Exo2-Regular", 12 * global_font_scale, 0.2, 0.8 )
